# Copy to .env and fill in. Never commit .env.

# SQL Server "sa" password: 8+ characters with upper, lower, digit and symbol
DB_PASSWORD=BookManager@2026

# HS512 needs at least 64 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Demo accounts (admin / librarian / reader) created on first start
SEED_DEMO_USERS=true
DEMO_PASSWORD=Demo@1234
